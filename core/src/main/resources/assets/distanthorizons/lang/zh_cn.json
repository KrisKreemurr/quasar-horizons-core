  "distanthorizons.config.client.advanced.graphics": "图形",
  "distanthorizons.config.client.advanced.worldGenerator": "世界生成器",
  "distanthorizons.config.client.advanced.server": "服务端",
  "distanthorizons.config.client.advanced.lodBuilding": "LOD 构建",
  "distanthorizons.config.client.advanced.multiThreading": "多线程",
  "distanthorizons.config.client.advanced.logging": "日志记录",

  "distanthorizons.config.client.advanced.graphics.quality": "渲染质量",

  "distanthorizons.config.client.advanced.graphics.quality.lodChunkRenderDistanceRadius": "渲染距离",
  "distanthorizons.config.client.advanced.graphics.quality.lodChunkRenderDistanceRadius.@tooltip": "遥远的地平线的渲染距离，以区块为单位。\n\n注意：这是一个期望数字。\n渲染距离可能高于或低于此数字\n取决于您的其他图形设置。",
  "distanthorizons.config.client.advanced.graphics.quality.horizontalQuality": "渲染质量下降水平步长",
  "distanthorizons.config.client.advanced.graphics.quality.horizontalQuality.@tooltip": "每次渲染质量下降之间的距离。\n\n更高的设置将增加每次下降之间的距离\n但会增加内存和GPU使用量。",
  "distanthorizons.config.client.advanced.graphics.quality.maxHorizontalResolution": "水平渲染粒度上限",
  "distanthorizons.config.client.advanced.graphics.quality.maxHorizontalResolution.@tooltip": "水平渲染粒度上限。\n\n§6最快：§r区块\n§6最精细：§r块",
  "distanthorizons.config.client.advanced.graphics.quality.verticalQuality": "垂直渲染质量",
  "distanthorizons.config.client.advanced.graphics.quality.verticalQuality.@tooltip": "悬垂、洞穴、悬崖等结构看起来的效果。\n\n更高的选项将增加内存和GPU使用量。",
  "distanthorizons.config.client.advanced.graphics.quality.horizontalScale": "水平缩放比例",
  "distanthorizons.config.client.advanced.graphics.quality.horizontalScale.@tooltip": "渲染质量随距离下降的速度。\n\n更大的数字将改善远处地形的外观\n但会增加内存和GPU使用量。",
  "distanthorizons.config.client.advanced.graphics.quality.transparency": "透明度",
  "distanthorizons.config.client.advanced.graphics.quality.blocksToIgnore": "忽略方块",
  "distanthorizons.config.client.advanced.graphics.quality.blocksToIgnore.@tooltip": "定义在渲染时忽略的方块（即渲染透明方块）类型。",
  "distanthorizons.config.client.advanced.graphics.quality.tintWithAvoidedBlocks": "渲染透明方块着色",
  "distanthorizons.config.client.advanced.graphics.quality.tintWithAvoidedBlocks.@tooltip": "§4注意：会使雪、地毯和活板门看起来很糟糕§r\n应该让下面的块获得被渲染透明方块的颜色吗？\n§6真：§r草地上的红色花朵会将下面的草染成红色\n§6假：§r跳过的块不会改变它们下面表面的颜色",
  "distanthorizons.config.client.advanced.graphics.quality.lodBias": "LOD偏移值§6(影响原版地形)§r",
  "distanthorizons.config.client.advanced.graphics.quality.lodBias.@tooltip": "设置原版的lod偏移值\n请按F3+T重新加载纹理包并应用此效果。",
  "distanthorizons.config.client.advanced.graphics.quality.lodShading": "LOD着色",
  "distanthorizons.config.client.advanced.graphics.quality.lodShading.@tooltip": "定义LOD应如何着色。\n可用于提高着色器兼容性。",
  "distanthorizons.config.client.advanced.graphics.quality.grassSideRendering": "草方块渲染",
  "distanthorizons.config.client.advanced.graphics.quality.grassSideRendering.@tooltip": "草方块 LOD 的侧面和底部应该如何渲染？",
  "distanthorizons.config.client.advanced.graphics.quality.ditherDhFade": "淡入淡出附近的LOD",
  "distanthorizons.config.client.advanced.graphics.quality.ditherDhFade.@tooltip": "如果为开启，当你靠近LOD时，它们会逐渐消失。\n如果为关闭，LOD会在距离相机一定距离时突然消失。\n此设置受原版防过度绘制配置的影响。",
  "distanthorizons.config.client.advanced.graphics.quality.vanillaFadeMode": "原版淡入淡出模式",
  "distanthorizons.config.client.advanced.graphics.quality.vanillaFadeMode.@tooltip": "原版Minecraft应该如何淡入淡出到遥远地平线的LOD中？\n\n无：最快，DH和MC渲染之间会有明显的边界。\n单通道：在MC的透明通道之后淡入淡出，水下的不透明方块不会被淡入淡出。\n双通道：最慢，在MC的不透明和透明通道之后淡入淡出，提供最平滑的过渡。",
  "distanthorizons.config.client.advanced.graphics.quality.brightnessMultiplier": "亮度乘数",
  "distanthorizons.config.client.advanced.graphics.quality.brightnessMultiplier.@tooltip": "LOD颜色的亮度。\n\n0 = 黑色 \n1 = 正常 \n2 = 接近白色",
  "distanthorizons.config.client.advanced.graphics.quality.saturationMultiplier": "饱和度乘数",
  "distanthorizons.config.client.advanced.graphics.quality.saturationMultiplier.@tooltip": "LOD颜色的饱和度。\n\n0 = 黑白 \n1 = 正常 \n2 = 鲜艳",
  "distanthorizons.config.client.advanced.graphics.quality.lodBiomeBlending": "生物群落融合",
  "distanthorizons.config.client.advanced.graphics.quality.lodBiomeBlending.@tooltip": "LOD区域的生物群落融合配置，与原版mc的配置相同。\n\n请注意，除了'0'之外的任何设置都会极大地影响Lod构建时间\n并增加三角形数。如果设置得太高，对区块生成速度的影响也很大。\n\n'0'等于原版生物群落融合的'1x1'，\n'1'等于原版生物群落融合的'3x3'，\n'2'等于原版生物群落融合的'5x5'...\n",

  "distanthorizons.config.client.advanced.graphics.ssao": "环境光遮蔽",

  "distanthorizons.config.client.advanced.graphics.ssao.enableSsao": "启用环境光遮蔽",
  "distanthorizons.config.client.advanced.graphics.ssao.enableSsao.@tooltip": "环境光遮蔽会为方块的光照增添立体感。",
  "distanthorizons.config.client.advanced.graphics.ssao.sampleCount": "采样数量",
  "distanthorizons.config.client.advanced.graphics.ssao.sampleCount.@tooltip": "决定在空间中为遮挡测试采样的点数。\n数值越高，质量越好，带状伪影越少，但会增加 GPU 负载。",
  "distanthorizons.config.client.advanced.graphics.ssao.radius": "半径",
  "distanthorizons.config.client.advanced.graphics.ssao.radius.@tooltip": "决定屏幕空间环境光遮蔽应用的半径，以块为单位测量。",
  "distanthorizons.config.client.advanced.graphics.ssao.strength": "强度",
  "distanthorizons.config.client.advanced.graphics.ssao.strength.@tooltip": "决定屏幕空间环境光遮蔽效果的强度。",
  "distanthorizons.config.client.advanced.graphics.ssao.bias": "偏差",
  "distanthorizons.config.client.advanced.graphics.ssao.bias.@tooltip": "增加该值可以减少带状伪影，但会降低效果的强度。",
  "distanthorizons.config.client.advanced.graphics.ssao.minLight": "最小光强",
  "distanthorizons.config.client.advanced.graphics.ssao.minLight.@tooltip": "决定遮挡阴影可以有多暗。\n0 = 角落完全黑色\n1 = 没有阴影",
  "distanthorizons.config.client.advanced.graphics.ssao.blurRadius": "模糊半径",
  "distanthorizons.config.client.advanced.graphics.ssao.blurRadius.@tooltip": "用于计算SSAO模糊的半径，以像素为单位。\n数值越高，减少带状伪影效果越好，但会牺牲GPU性能。",

  "distanthorizons.config.client.advanced.graphics.genericRendering": "通用对象渲染",

  "distanthorizons.config.client.advanced.graphics.genericRendering.enableGenericRendering": "启用渲染",
  "distanthorizons.config.client.advanced.graphics.genericRendering.enableGenericRendering.@tooltip": "如果为真，非地形对象将在DH的地形中渲染。\n这包括信标光束和云。",
  "distanthorizons.config.client.advanced.graphics.genericRendering.enableBeaconRendering": "渲染信标",
  "distanthorizons.config.client.advanced.graphics.genericRendering.enableBeaconRendering.@tooltip": "如果为开启，将渲染LOD信标光束。",
  "distanthorizons.config.client.advanced.graphics.genericRendering.enableCloudRendering": "渲染云",
  "distanthorizons.config.client.advanced.graphics.genericRendering.enableCloudRendering.@tooltip": "如果为开启，将渲染LOD云。",
  "distanthorizons.config.client.advanced.graphics.genericRendering.enableInstancedRendering": "启用实例渲染",
  "distanthorizons.config.client.advanced.graphics.genericRendering.enableInstancedRendering.@tooltip": "可以禁用以使用更慢但更兼容的直接渲染。\n禁用此选项可用于修复Mac上的一些崩溃问题。",

  "distanthorizons.config.client.advanced.graphics.fog": "雾",

  "distanthorizons.config.client.advanced.graphics.fog.enableDhFog": "雾绘制模式",
  "distanthorizons.config.client.advanced.graphics.fog.enableDhFog.@tooltip": "雾将在何时渲染到LOD上。",
  "distanthorizons.config.client.advanced.graphics.fog.colorMode": "雾颜色模式",
  "distanthorizons.config.client.advanced.graphics.fog.colorMode.@tooltip": "LOD渲染时雾的颜色。",
  "distanthorizons.config.client.advanced.graphics.fog.enableVanillaFog": "启用原版雾",
  "distanthorizons.config.client.advanced.graphics.fog.enableVanillaFog.@tooltip": "§6开启：§r 按原版方式渲染雾。\n§6关闭：§r 禁用区块上的原版雾。\n\n可能会导致与其他修改雾的mod冲突。",
  "distanthorizons.config.client.advanced.graphics.fog.advancedFog": "高级雾选项",

  "distanthorizons.config.client.advanced.graphics.fog.farFogStart": "远景雾开始",
  "distanthorizons.config.client.advanced.graphics.fog.farFogStart.@tooltip": "远景雾应该从哪里开始？\n\n'0.0'：雾从玩家位置开始。\n'1.0'：远景雾起始圆圈恰好包含lod渲染正方形。\n'1.414'：lod渲染正方形恰好包含远景雾起始圆圈。\n",
  "distanthorizons.config.client.advanced.graphics.fog.farFogEnd": "远景雾结束",
  "distanthorizons.config.client.advanced.graphics.fog.farFogEnd.@tooltip": "远景雾应该在哪里结束？\n\n'0.0'：雾在玩家位置结束。\n'1.0'：远景雾结束圆圈恰好包含lod渲染正方形。\n'1.414'：lod渲染正方形恰好包含远景雾结束圆圈。\n",
  "distanthorizons.config.client.advanced.graphics.fog.farFogMin": "远景雾最小浓度",
  "distanthorizons.config.client.advanced.graphics.fog.farFogMin.@tooltip": "最小雾浓度是多少？\n\n'0.0'：完全没有雾。\n'1.0'：只看得到雾。\n",
  "distanthorizons.config.client.advanced.graphics.fog.farFogMax": "远景雾最大浓度",
  "distanthorizons.config.client.advanced.graphics.fog.farFogMax.@tooltip": "最大雾浓度是多少？\n\n'0.0'：完全没有雾。\n'1.0'：只看得到雾。\n",
  "distanthorizons.config.client.advanced.graphics.fog.farFogFalloff": "远景雾衰减",
  "distanthorizons.config.client.advanced.graphics.fog.farFogFalloff.@tooltip": "雾浓度应该如何计算？\n\n线性：基于距离的线性（将忽略“浓度”）\n指数：1/(e^(距离*浓度))\n指数平方：1/(e^((距离*浓度)^2)\n",
  "distanthorizons.config.client.advanced.graphics.fog.farFogDensity": "远景雾浓度",
  "distanthorizons.config.client.advanced.graphics.fog.farFogDensity.@tooltip": "雾有多浓？",

  "distanthorizons.config.client.advanced.graphics.fog.heightFog": "高空雾选项",

  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMixMode": "高空雾融合模式",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMixMode.@tooltip": "高度如何影响雾的浓度？\n\n基本：没有特殊的高空雾效果。雾是根据相机距离计算的。\n忽略高度：完全忽略高度。雾是根据水平距离计算的。\n加法：heightFog + farFog。\n最大值：max(heightFog, farFog)。\n乘法：heightFog * farFog。\n反向乘法：1 - (1-heightFog) * (1-farFog)。\n有限加法：farFog + max(farFog, heightFog)。\n乘法加法：farFog + farFog * heightFog。\n反向乘法加法：farFog + 1 - (1-heightFog) * (1-farFog)。\n平均：farFog*0.5 + heightFog*0.5。\n\n请注意，对于“基本”模式和“忽略高度”模式，高空雾设置没有效果。",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDirection": "高空雾方向",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDirection.@tooltip": "高空雾应该位于何处？\n\n高于相机：高空雾从相机开始到天空。\n低于相机：高空雾从相机开始到虚空。\n高于和低于相机：高空雾从相机开始到天空和虚空。\n高于设定高度：高空雾从设定高度开始到天空。\n低于设定高度：高空雾从设定高度开始到虚空。\n高于和低于设定高度：高空雾从设定高度开始到天空和虚空。",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogBaseHeight": "高空雾基础高度",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogBaseHeight.@tooltip": "如果高空雾是围绕设定高度计算的，那么这个高度位置是多少？",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogStart": "高空雾开始",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogStart.@tooltip": "高空雾的开始应该偏移多远？\n\n'0.0'：雾开始时没有偏移。\n'1.0'：雾开始时偏移整个世界的高度。（包括深度）",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogEnd": "高空雾结束",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogEnd.@tooltip": "高空雾的结束应该偏移多远？\n\n'0.0'：雾结束时没有偏移。\n'1.0'：雾结束时偏移整个世界的高度。（包括深度）",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMin": "高空雾最小浓度",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMin.@tooltip": "最小雾浓度是多少？\n\n'0.0': 完全没有雾。\n'1.0': 只看得到雾。\n",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMax": "高空雾最大浓度",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogMax.@tooltip": "最大雾浓度是多少？\n\n'0.0': 完全没有雾。\n'1.0': 只看得到雾。\n",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogFalloff": "高空雾衰减",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogFalloff.@tooltip": "高空雾浓度应该如何计算？\n\nLINEAR: 基于高度的线性衰减（将忽略 '浓度'）\nEXPONENTIAL: 1/(e^(高度*浓度))\nEXPONENTIAL_SQUARED: 1/(e^((高度*浓度)^2)\n",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDensity": "高空雾浓度",
  "distanthorizons.config.client.advanced.graphics.fog.heightFog.heightFogDensity.@tooltip": "高空雾的浓度是多少？ ",

  "distanthorizons.config.client.advanced.graphics.noiseTexture": "噪波纹理",

  "distanthorizons.config.client.advanced.graphics.noiseTexture.enableNoiseTexture": "启用噪波纹理",
  "distanthorizons.config.client.advanced.graphics.noiseTexture.enableNoiseTexture.@tooltip": "如果启用，将在 LOD 上应用噪波纹理以模拟纹理。",
  "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseSteps": "噪声次数",
  "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseSteps.@tooltip": "确定应将多少次噪声应用于 LOD。",
  "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseIntensity": "噪声强度",
  "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseIntensity.@tooltip": "确定噪声纹理的强度。",
  "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseDropoff": "噪声衰减",
  "distanthorizons.config.client.advanced.graphics.noiseTexture.noiseDropoff.@tooltip": "定义噪声纹理在消失前应渲染多远。（以块为单位）\n设置为 0 以禁用噪声衰减。",

  "distanthorizons.config.client.advanced.graphics.culling": "渲染剔除",

  "distanthorizons.config.client.advanced.graphics.culling.overdrawPrevention": "防止过度绘制",
  "distanthorizons.config.client.advanced.graphics.culling.overdrawPrevention.@tooltip": "确定相机多远时，遥远地平线将开始渲染。\n以原版渲染距离的百分比衡量。\n\n较高的值将防止 LOD 在更远的距离渲染在原版块后面，\n但可能会导致 LOD 中出现空洞。\n当飞越未加载的地形时，最有可能出现空洞。\n\n增加原版渲染距离会提高此设置的效果。",
  "distanthorizons.config.client.advanced.graphics.culling.enableCaveCulling": "洞穴剔除",
  "distanthorizons.config.client.advanced.graphics.culling.enableCaveCulling.@tooltip": "如果启用，洞穴将被剔除\n\n附加信息：目前，在没有天花板的维度中，这个剔除会剔除所有在洞穴剔除高度以下且天光值为0的面。",
  "distanthorizons.config.client.advanced.graphics.culling.caveCullingHeight": "洞穴剔除高度",
